{
  "name": "marpol-ppm",
  "private": true,
  "version": "1.0.0",
  "description": "Marpol Uretim Yonetim Sistemi (Production Process Management)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:push": "npm run prisma:push -w server",
    "seed": "npm run seed -w server",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently -n API,WEB -c red,blue \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build -w server && npm run build -w web",
    "setup": "npm install && npm run db:up && npm run prisma:migrate && npm run seed",
    "lint": "npm run icons:check -w web && eslint server/src web/src",
    "lint:fix": "eslint server/src web/src --fix",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:deploy": "npm run prisma:deploy -w server",
    "test": "npm run test -w server",
    "icons": "npm run icons -w web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.68.0"
  },
  "type": "module"
}
