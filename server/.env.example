# Bu dosya sablondur ve depoya eklenir. GERCEK DEGER YAZMAYIN.
# Kopyalayin:  cp .env.example .env   ve degerleri .env icinde doldurun.

# --- Veritabani ---------------------------------------------------------
# docker-compose.yml ile ayni kullanici/sifre olmalidir.
DATABASE_URL="postgresql://KULLANICI:SIFRE@localhost:5433/marpol_ppm?schema=public"

# --- Kimlik dogrulama ---------------------------------------------------
# ZORUNLU. En az 32 karakter. Ornek dosyadaki degerler reddedilir.
# Uretmek icin:  openssl rand -base64 48
JWT_SECRET=""

# Token gecerlilik suresi. Bir vardiya varsayilan kabul edildi.
JWT_EXPIRES_IN="8h"

# Sifre hashleme maliyeti (10-15). Yuksek deger = yavas ama guvenli.
BCRYPT_ROUNDS=12

# --- Sunucu -------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Izin verilen istemci adresleri (virgulle ayrilir).
# NODE_ENV=production iken ZORUNLUDUR, varsayilana dusmez.
CORS_ORIGIN="http://localhost:5173"

# Ters vekil (nginx vb.) arkasinda calisiyorsa audit IP'lerinin dogru
# kaydedilmesi icin guvenilen vekil sayisi.
# TRUST_PROXY=1
